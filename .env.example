# ==============================================================================
# SpectraAI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the project root to customize local settings.
# All variables are OPTIONAL. SpectraAI runs out-of-the-box in Fallback/Demo mode
# if no variables are configured.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Anthropic Claude Vision API Key (Optional)
# ------------------------------------------------------------------------------
# Set this key to enable live Claude 3.5 Sonnet Vision extraction for uploaded
# PDF datasheets and nameplate images.
# If omitted or empty, SpectraAI runs in Smart Fallback Mode (deterministic
# synthetic data for the UltraDrive X500 demo motor — no API tokens consumed).
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (Optional)
# ------------------------------------------------------------------------------
# HOST: Network interface to bind the FastAPI backend server (default: 0.0.0.0)
# PORT: Port for the FastAPI backend server (default: 8000)
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 3. Frontend Dev Server Configuration (Optional)
# ------------------------------------------------------------------------------
# VITE_API_URL: Backend URL accessed by the frontend (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000
